# Millionaire Trading Journal configuration. Copy to .env and fill in.
# Never commit .env. All secrets are read server-side only.

# Where the SQLite database and uploaded images live (outside the web root).
DATA_DIR=./data

# Public base URL of the app (used to build the TradingView webhook URL and MT5 bridge commands).
# TradingView can only reach a public HTTPS address on port 443 or 80.
APP_URL=http://localhost:3000

# Set to "true" only when served over HTTPS (marks cookies Secure).
COOKIE_SECURE=false

# Allow new account registration (set false after creating your account).
ALLOW_REGISTRATION=true

# --- TradingView webhook ---
# "true" accepts alerts only from TradingView's published IPs. Enable only behind a proxy
# that sets X-Forwarded-For reliably (otherwise the header can be spoofed or missing).
TRADINGVIEW_IP_ALLOWLIST=false

# --- AI: screenshot analysis, quick entry from screenshots, trade reviews, weekly/monthly summaries, coach ---
# Server-side only; never exposed to the browser or logged. Leave empty to turn AI off (nothing is simulated).
ANTHROPIC_API_KEY=
# Optional. Default claude-opus-5-5.
ANTHROPIC_MODEL=claude-opus-5-5

# --- Market data: automatic trend / higher-timeframe bias / volatility / key-level context per trade ---
# Options: none | oanda | twelvedata. "none" turns it off; nothing is estimated without a provider.
MARKET_DATA_PROVIDER=none
# OANDA v20 personal access token (OANDA account > Manage API Access). Used read-only: candles only, no trading.
OANDA_API_TOKEN=
# practice -> api-fxpractice.oanda.com, live -> api-fxtrade.oanda.com. A token only works in its own environment.
OANDA_ENV=practice
# Twelve Data API key. Free Basic plan: 8 requests/minute, 800/day; the app spaces requests about 8 s apart.
TWELVEDATA_API_KEY=

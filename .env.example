# Millionaire Trading Journal configuration. Copy to .env and fill in.
# Never commit .env. All secrets are read server-side only.

# Where the SQLite database and uploaded images live (outside the web root).
DATA_DIR=./data

# Public base URL of the app (used to build webhook URLs shown in Settings).
APP_URL=http://localhost:3000

# Set to "true" only when served over HTTPS (marks cookies Secure).
COOKIE_SECURE=false

# Allow new account registration (set false after creating your account).
ALLOW_REGISTRATION=true

# --- AI (Phase 5). Leave empty to disable AI features. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Market data (Phase 4). "none" disables automatic context. ---
# Options: none | oanda | twelvedata
MARKET_DATA_PROVIDER=none
OANDA_API_TOKEN=
OANDA_ENV=practice
TWELVEDATA_API_KEY=
